# Server env. Read ONLY by server/config.ts, server/lib/mongo.ts and scripts/*.
# The client never reads this file — its VITE_* vars live in client/.env.
# MongoDB connection string; MUST include the database name (…mongodb.net/<db>)
MONGODB_URI=
# Server wallet private key (hex). SECRET — store in a secrets manager in prod.
SERVER_PRIVATE_KEY=
# Wallet-toolbox storage service URL.
WALLET_STORAGE_URL=
# JWT signing secret for the `verified` cookie. SECRET, min 32 chars.
JWT_SECRET=
# Minimum wallet balance for the /api/ready probe. NOTE: compared against an output
# COUNT, not satoshis — see checkWalletBalance.
MIN_BALANCE=
# Express port for the standalone API (default 3001).
PORT=
# Credentialed CORS allowlist, comma-separated origins. Empty = same-origin only,
# which blocks the split-origin client. Dev: http://localhost:5173
ALLOWED_ORIGINS=
