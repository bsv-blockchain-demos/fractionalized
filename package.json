{
  "name": "fraction",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run server:dev",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "client:dev": "npm run dev -w @fraction/client",
    "client:build": "npm run build -w @fraction/client",
    "build": "npm run client:build",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:client": "npm test -w @fraction/client",
    "test:all": "npm test && npm run test:client",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "list-shares": "tsx scripts/list-shares.ts",
    "trace-chain": "tsx scripts/trace-chain.ts",
    "migrate-mint-txid": "tsx scripts/migrate-mint-txid.ts",
    "broadcast-failed-listing": "tsx scripts/broadcast-failed-listing.ts",
    "broadcast-failed-listing-file": "tsx scripts/broadcast-failed-listing-file.ts"
  },
  "dependencies": {
    "@bsv/auth": "^0.0.1",
    "@bsv/sdk": "^2.1.4",
    "@bsv/wallet-helper": "^0.0.5",
    "@bsv/wallet-toolbox": "^2.1.5",
    "@bsv/wallet-toolbox-client": "^2.1.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "jose": "^6.1.0",
    "mongodb": "^6.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "ts-jest": "^29.4.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0"
  }
}
