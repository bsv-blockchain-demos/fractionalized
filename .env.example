# MongoDB connection string; MUST include the database name (…mongodb.net/<db>)
MONGODB_URI=
# Server wallet private key (hex). SECRET — store in a secrets manager in prod.
SERVER_PRIVATE_KEY=
# Server's legacy [0,'fractionalized']/'0' public key (compressed hex). Public.
NEXT_PUBLIC_SERVER_PUBLIC_KEY=
# Server wallet IDENTITY key (compressed hex) — type-42 counterparty + auth-proof server id. Public.
NEXT_PUBLIC_SERVER_IDENTITY_KEY=
# Wallet-toolbox storage service URL.
WALLET_STORAGE_URL=
# Minimum wallet balance (sats) for the /ready probe.
MIN_BALANCE=
# JWT signing secret for the `verified` cookie. SECRET, min 32 chars.
JWT_SECRET=
# Server vars may live here or in server/.env — server/config.ts loads both, and
# server/.env wins. Plan C makes server/.env the single authoritative location.
# Express port for the standalone API (default 3001).
PORT=
# Credentialed CORS allowlist, comma-separated origins. Empty = same-origin only.
ALLOWED_ORIGINS=
# Base URL the client sends API requests to, e.g. http://localhost:3001 during the
# Express bridge. EMPTY = same-origin, i.e. the Next API routes (pre-bridge default).
# Becomes VITE_API_BASE once the client moves to Vite. Public — no secret here.
NEXT_PUBLIC_API_BASE=
