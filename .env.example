# Client env. Read by the Next client today, and by client/ after the Vite migration.
# Server secrets do NOT belong here — see server/.env.example. Everything in this file
# is inlined into the public browser bundle, so it must all be safe to publish.
# Base URL for API requests, e.g. http://localhost:3001. Empty = same-origin.
# Becomes VITE_API_BASE once the client moves to Vite.
NEXT_PUBLIC_API_BASE=
# Server's legacy [0,'fractionalized']/'0' public key (compressed hex). Public.
NEXT_PUBLIC_SERVER_PUBLIC_KEY=
# Server wallet IDENTITY key (compressed hex) — type-42 counterparty + auth-proof server id. Public.
NEXT_PUBLIC_SERVER_IDENTITY_KEY=
