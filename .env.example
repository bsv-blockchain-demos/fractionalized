# MongoDB connection string; MUST include the database name (…mongodb.net/<db>)
MONGODB_URI=
# Server wallet private key (hex). SECRET — store in a secrets manager in prod.
SERVER_PRIVATE_KEY=
# Server's legacy [0,'fractionalized']/'0' public key (compressed hex). Public.
NEXT_PUBLIC_SERVER_PUBLIC_KEY=
# Server wallet IDENTITY key (compressed hex) — type-42 counterparty + auth-proof server id. Public.
NEXT_PUBLIC_SERVER_IDENTITY_KEY=
# Wallet-toolbox storage service URL.
WALLET_STORAGE_URL=
# Minimum wallet balance (sats) for the /ready probe.
MIN_BALANCE=
# JWT signing secret for the `verified` cookie. SECRET, min 32 chars.
JWT_SECRET=
